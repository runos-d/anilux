+def grouped_unread(conversation_id, rows, hidden_history):
+    """Scan common visibility windows once, instead of once per viewer.
+
+    Each UNION statement sees message totals and receipts in the same SQL
+    snapshot. Output is bounded by viewer IDs + one bucket for other senders.
+    Many different clear/join bounds retain the general correlated reader.
+    """
+    groups = {}
+    for row in rows:
+        key = (row['projection_cleared'], row.get('projection_joined') if hidden_history else None)
+        groups.setdefault(key, []).append(row['pk'])
+    if len(groups) > 4:
+        return None
+    output = {}
+    for (cleared, joined), viewers in groups.items():
+        # This fixed parameterized query avoids repeated ORM UNION compilation
+        # in every fanout batch. Only model table identifiers enter SQL text;
+        # viewer IDs/bounds are parameters from the current primary ACL query.
+        messages = connection.ops.quote_name(Message._meta.db_table)
+        receipts = connection.ops.quote_name(MessageReadStatus._meta.db_table)
+        placeholders = ','.join(['%s'] * len(viewers))
+        scope = 'm.conversation_id=%s AND m.is_deleted=%s AND m.seq>%s'
+        bounds = [conversation_id, False, cleared]
+        if joined is not None:
+            scope += ' AND m.created_at>=%s'
+            bounds.append(connection.ops.adapt_datetimefield_value(joined))
+        sql = f'''SELECT CASE WHEN m.sender_id IN ({placeholders}) THEN m.sender_id ELSE 0 END AS who,
+                          COUNT(*), 0 FROM {messages} m WHERE {scope} GROUP BY who
+                  UNION ALL SELECT r.user_id, COUNT(*), 1 FROM {receipts} r
+                  JOIN {messages} m ON m.id=r.message_id
+                  WHERE r.user_id IN ({placeholders}) AND {scope} AND m.sender_id<>r.user_id
+                  GROUP BY r.user_id'''
+        by_sender, by_reader = {}, {}
+        with connection.cursor() as cursor:
+            cursor.execute(sql, [*viewers, *bounds, *viewers, *bounds])
+            for uid, count, source in cursor.fetchall():
+                (by_sender if source == 0 else by_reader)[uid] = count
+        total = sum(by_sender.values())
+        output.update({uid: total - by_sender.get(uid, 0) - by_reader.get(uid, 0) for uid in viewers})
+    return output
+
