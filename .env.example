# Public identity (replace every placeholder before production)
PROJECT_BRAND_NAME=AniLux
VITE_PROJECT_BRAND_NAME=AniLux
PROJECT_PUBLIC_DOMAIN=example.invalid
FRONTEND_PUBLIC_URL=http://localhost:5173
TRANSACTIONAL_FROM_EMAIL=no-reply@example.invalid
TRANSACTIONAL_REPLY_TO_EMAIL=

# Django
DJANGO_SETTINGS_MODULE=config.settings
DEBUG=true
SECRET_KEY=replace-with-a-long-random-value
SITE_URL=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:8000

# Database
DB_NAME=anilux
DB_USER=anilux
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=mysql
DB_PORT=3306
DB_LOCAL_PORT=3307
# Reuse only the driver's unchanged default TLS configuration; no connection pool.
DB_TLS_CONTEXT_CACHE=true
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password

# Redis
# Dead websocket group memberships expire; live sockets refresh on heartbeat.
WS_GROUP_EXPIRY=300
REDIS_HOST=redis
REDIS_SOCKET_TIMEOUT=2
REDIS_PORT=6379
REDIS_DB=0

# Release feature gates are fail-closed.
FEATURE_DUBS_ENABLED=false
FEATURE_REACTOR_ENABLED=false
FEATURE_TWO_FACTOR_ENABLED=false
FEATURE_STUDIO_REACTIONS_ENABLED=false
FEATURE_STUDIO_SYNC_ENABLED=false
VITE_FEATURE_DUBS_ENABLED=false
VITE_FEATURE_REACTOR_ENABLED=false
VITE_FEATURE_TWO_FACTOR_ENABLED=false
VITE_FEATURE_STUDIO_REACTIONS_ENABLED=false
VITE_FEATURE_STUDIO_SYNC_ENABLED=false
VITE_SCREENSHOT_EXTENSION_ID=
VITE_SCREENSHOT_EXTENSION_INSTALL_URL=
VITE_API_URL=
VITE_BASE_URL=/

# Optional analytics. Empty IDs and false flags keep providers fully disabled.
VITE_YANDEX_METRIKA_ENABLED=false
VITE_YANDEX_METRIKA_ID=
VITE_GOOGLE_ANALYTICS_ENABLED=false
VITE_GOOGLE_ANALYTICS_ID=
ANALYTICS_CONSENT_POLICY_VERSION=2026-10-27.1
DATA_EXPORT_ROOT=
DATA_EXPORT_TTL_HOURS=168

# Optional external catalog integration. Keep secrets empty in Git.
KODIK_API_TOKEN=
KODIK_API_BASE=
KODIK_PUBLIC_KEY=
KODIK_PRIVATE_KEY=
KODIK_VIDEO_BASE=https://kodikres.com
SHIKIMORI_BASE_URL=https://shikimori.one/api
SHIKIMORI_USER_AGENT=anilux/1.0
SHIKIMORI_API_TIMEOUT=15
SHIKIMORI_CLIENT_ID=
SHIKIMORI_CLIENT_SECRET=

ENVIRONMENT=development
EMAIL_PROVIDER=mailpit
EMAIL_TIMEOUT_SECONDS=10
EMAIL_FAIL_SILENTLY=false
EMAIL_CONFIRM_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_WEBHOOK_BEARER_TOKEN=
BREVO_API_KEY=
# Admission is per Daphne process; tune against DB and RAM budgets.
ASGI_HTTP_CONCURRENCY=64
ASGI_WEBSOCKET_CONNECTIONS=2048

# ASGI closes request-scoped database connections.
DB_CONN_MAX_AGE=0
