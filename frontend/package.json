{
  "name": "anime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest --exclude \"tests/visual/**\"",
    "build-only": "node scripts/run-vite-build.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "test:unit:run": "vitest run --exclude \"tests/visual/**\"",
    "test:visual": "playwright test",
    "audit:production": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@heroicons/vue": "^2.2.0",
    "@tanstack/vue-query": "^5.101.4",
    "@unpic/vue": "^1.0.0",
    "anime4k.js": "1.1.3",
    "axios": "^1.20.0",
    "dompurify": "^3.4.16",
    "hls.js": "^1.7.3",
    "kodikwrapper": "^3.1.0",
    "markdown-it": "^15.0.2",
    "pinia": "^3.0.4",
    "vite-plugin-pwa": "^2.0.0",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "flatted": "^3.4.2",
    "lodash": "^4.17.24",
    "shell-quote": "^1.8.5",
    "ws": "^8.21.0",
    "postcss-selector-parser": "^7.1.6",
    "nanoid": "^5.1.16",
    "workbox-build": {
      "glob": "^13.0.6"
    },
    "js-beautify": {
      "nopt": "^9.0.0"
    }
  },
  "devDependencies": {
    "@argos-ci/playwright": "^7.8.0",
    "@playwright/test": "^1.64.1",
    "@tsconfig/node24": "^24.0.3",
    "@types/jsdom": "^27.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.10.9",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/eslint-plugin": "^1.6.5",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.6.1",
    "jsdom": "^27.4.0",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.6",
    "sass": "^1.97.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.2.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "vue-demi@0.14.10": true,
    "esbuild@0.28.2": true
  }
}
