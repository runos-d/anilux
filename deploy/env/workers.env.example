# Copy your existing application environment, then override these values.
# Never deploy these placeholders; all app/worker nodes share the SAME SECRET_KEY.
BACKEND_IMAGE=anilux-backend:local-release
WORKER_ENV_FILE=/srv/animecore/workers.env
APP_BIND_IP=10.80.0.21
SHARED_DATA_PATH=/srv/animecore/data
API_PROCESSES=2
HTTP_CONCURRENCY=32
SOCKETS_PER_PROCESS=4096
DB_HOST=10.80.0.10
DB_PORT=3306
DB_NAME=animecore
DB_USER=animecore
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
REDIS_HOST=10.80.0.10
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
SECRET_KEY=REPLACE_WITH_THE_SAME_APPLICATION_SECRET
DEBUG=false
WS_GROUP_EXPIRY=300
ENVIRONMENT=production
WS_ALLOW_QUERY_TOKEN=false
ALLOWED_HOSTS=example.org,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://example.org
CORS_ALLOWED_ORIGINS=https://example.org
FRONTEND_URL=https://example.org
SITE_URL=https://example.org
NATIVE_APP_SITE_URL=https://example.org
