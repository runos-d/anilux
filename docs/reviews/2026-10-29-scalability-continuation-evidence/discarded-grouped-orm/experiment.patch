+def grouped_unread(conversation_id, rows, hidden_history):
+    """Scan common visibility windows once, instead of once per viewer.
+
+    Each UNION statement sees message totals and receipts in the same SQL
+    snapshot. Output is bounded by viewer IDs + one bucket for other senders.
+    Many different clear/join bounds retain the general correlated reader.
+    """
+    groups = {}
+    for row in rows:
+        key = (row['projection_cleared'], row.get('projection_joined') if hidden_history else None)
+        groups.setdefault(key, []).append(row['pk'])
+    if len(groups) > 4:
+        return None
+    output = {}
+    for (cleared, joined), viewers in groups.items():
+        messages = Message.objects.filter(conversation_id=conversation_id, is_deleted=False, seq__gt=cleared)
+        receipts = MessageReadStatus.objects.filter(user_id__in=viewers,
+            message__conversation_id=conversation_id, message__is_deleted=False, message__seq__gt=cleared)
+        if joined is not None:
+            messages = messages.filter(created_at__gte=joined)
+            receipts = receipts.filter(message__created_at__gte=joined)
+        totals = messages.order_by().annotate(viewer_sender=Case(
+            When(sender_id__in=viewers, then=F('sender_id')), default=Value(0),
+            output_field=PositiveBigIntegerField())).values('viewer_sender').annotate(
+                total=Count('pk'), source=Value('messages', output_field=CharField()))
+        reads = receipts.exclude(message__sender_id=F('user_id')).order_by().values('user_id').annotate(
+            total=Count('pk'), source=Value('reads', output_field=CharField()))
+        by_sender, by_reader = {}, {}
+        for uid, count, source in totals.values_list('viewer_sender', 'total', 'source').union(
+                reads.values_list('user_id', 'total', 'source'), all=True):
+            (by_sender if source == 'messages' else by_reader)[uid] = count
+        total = sum(by_sender.values())
+        output.update({uid: total - by_sender.get(uid, 0) - by_reader.get(uid, 0) for uid in viewers})
+    return output
+
+
